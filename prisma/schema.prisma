generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model USER {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  phone     String
  role      Role
  status    UserStatus
  createAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
